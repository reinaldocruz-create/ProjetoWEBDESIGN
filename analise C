<?php
// api/admin/analisar-candidato.php - Marcar Candidato em Análise
session_start();
header("Content-Type: application/json; charset=UTF-8");

if(!isset($_SESSION['logado']) || $_SESSION['usuario_tipo'] !== 'admin') {
    http_response_code(403);
    echo json_encode(array("success" => false, "message" => "Acesso negado."));
    exit;
}

include_once '../../config/database.php';

$database = new Database();
$db = $database->getConnection();

$data = json_decode(file_get_contents("php://input"));

if(!empty($data->id)) {
    $query = "UPDATE candidatos SET status = 'em_analise' WHERE id = :id";
    $stmt = $db->prepare($query);
    $stmt->bindParam(":id", $data->id);
    
    if($stmt->execute()) {
        http_response_code(200);
        echo json_encode(array("success" => true, "message" => "Status atualizado com sucesso!"));
    } else {
        http_response_code(503);
        echo json_encode(array("success" => false, "message" => "Erro ao atualizar status."));
    }
} else {
    http_response_code(400);
    echo json_encode(array("success" => false, "message" => "ID não fornecido."));
}
?>
